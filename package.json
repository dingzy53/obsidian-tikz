{
	"name": "obsidian-tikz",
	"version": "1.3.0",
	"description": "Obsidian desktop plugin: render TikZ code blocks with a local TeX installation.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"lint:review": "eslint --config eslint.review.config.mjs --max-warnings 0 .",
		"test": "vitest run",
		"test:watch": "vitest",
		"m1": "TIKZ_NATIVE_INTEGRATION=1 vitest run test/engine.integration.test.ts",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"clean": "node -e \"['main.js', 'main.js.map'].forEach(f => { try { fs.unlinkSync(f); } catch {} })\"",
		"test:unit": "vitest run",
		"check:mobile": "vitest run test/mobileLoad.test.ts",
		"test:e2e": "wdio run ./wdio.conf.mts",
		"test:e2e:fast": "OBSIDIAN_VERSIONS=latest/latest OBSIDIAN_E2E_TARGET=desktop wdio run ./wdio.conf.mts",
		"test:e2e:mobile": "OBSIDIAN_VERSIONS=latest/latest OBSIDIAN_E2E_TARGET=mobile wdio run ./wdio.conf.mts",
		"test:e2e:android": "wdio run ./wdio.mobile.conf.mts"
	},
	"keywords": [
		"obsidian",
		"tikz",
		"latex"
	],
	"author": "Ding Zheng Yuan",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dingzy53/obsidian-tikz.git"
	},
	"license": "MIT",
	"dependencies": {
		"svgo": "^3.3.2"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.10.2",
		"@wdio/appium-service": "^9.33.1",
		"@wdio/cli": "^9.33.1",
		"@wdio/globals": "^9.31.3",
		"@wdio/local-runner": "^9.33.1",
		"@wdio/mocha-framework": "^9.33.1",
		"@wdio/spec-reporter": "^9.33.1",
		"appium": "^3.9.1",
		"appium-uiautomator2-driver": "^7.6.2",
		"esbuild": "^0.24.2",
		"eslint": "^9.17.0",
		"eslint-plugin-obsidianmd": "^0.5.0",
		"mocha": "^10.8.2",
		"obsidian": "^1.13.1",
		"tslib": "^2.8.1",
		"tsx": "^4.23.15",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.18.1",
		"vitest": "^2.1.8",
		"wdio-obsidian-reporter": "^3.5.0",
		"wdio-obsidian-service": "^3.5.0"
	}
}
