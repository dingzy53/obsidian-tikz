{
	"name": "obsidian-tikz",
	"version": "1.1.1",
	"description": "Obsidian desktop plugin: render TikZ code blocks with a local TeX installation.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"m1": "TIKZ_NATIVE_INTEGRATION=1 vitest run test/engine.integration.test.ts",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"clean": "node -e \"['main.js', 'main.js.map'].forEach(f => { try { fs.unlinkSync(f); } catch {} })\""
	},
	"keywords": [
		"obsidian",
		"tikz",
		"latex"
	],
	"author": "ding",
	"license": "MIT",
	"dependencies": {
		"svgo": "^3.3.2"
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"esbuild": "^0.24.2",
		"eslint": "^9.17.0",
		"obsidian": "^1.13.1",
		"tslib": "^2.8.1",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.18.1",
		"vitest": "^2.1.8"
	}
}
