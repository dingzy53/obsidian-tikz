{
	"compilerOptions": {
		"baseUrl": ".",
		"module": "ESNext",
		"target": "ES2022",
		"moduleResolution": "bundler",
		"strict": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"exactOptionalPropertyTypes": false,
		"isolatedModules": true,
		"skipLibCheck": true,
		"importHelpers": true,
		"inlineSourceMap": true,
		"inlineSources": true,
		"lib": [
			"DOM",
			"ES2022"
		],
		"types": [
			"node"
		]
	},
	"include": [
		"src/**/*.ts",
		"test/**/*.ts",
		"esbuild.config.mjs"
	]
}
